# Example environment variables for the backend (do NOT commit secrets)
# Copy to `.env` and fill values for local development
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_EXPIRE_MINUTES=60

# Database: leave commented to use default sqlite or set a Postgres URL
# Example Postgres: postgresql+psycopg2://user:pass@localhost:5432/dbname
DATABASE_URL=sqlite:///./kisan.db

# Firebase removed: no service account required

# Optional runtime overrides
# PORT=8000
# DEBUG=true
